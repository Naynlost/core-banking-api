# docker-compose bu değişkenleri okur. Kopyalayıp `.env` olarak kaydet ve değerleri düzenle:
#   cp .env.example .env
# Hiçbiri zorunlu değildir; ayarlanmazsa docker-compose'daki yerel varsayılanlar kullanılır.
# `.env` git'e girmez (.gitignore). Gerçek sırları buraya değil, ortama enjekte et.

# PostgreSQL
POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking_dev

# RabbitMQ
RABBITMQ_USER=banking
RABBITMQ_PASSWORD=banking_dev

# JWT imzalama anahtarı. En az 32 byte olmalı. Üretimde mutlaka güçlü, rastgele bir değer ver.
JWT_SECRET=yerel-demo-icin-en-az-32-byte-uzunlugunda-secret
