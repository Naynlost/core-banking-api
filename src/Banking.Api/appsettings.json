{
  "Jwt": {
    "Issuer": "Banking.Api",
    "Audience": "Banking.Api",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  },
  "Fx": {
    "BaseCurrency": "TRY",
    "Rates": {
      "USD": 41.50,
      "EUR": 45.20
    }
  },
  "Retention": {
    "MessagingDays": 7,
    "IdempotencyHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
